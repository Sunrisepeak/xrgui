diff --git a/src/utility/generic/cond_exist.ixx b/src/utility/generic/cond_exist.ixx
index cc460f5..523d7ff 100644
--- a/src/utility/generic/cond_exist.ixx
+++ b/src/utility/generic/cond_exist.ixx
@@ -104,7 +104,15 @@ struct cond_exist<T, true>{
 		requires requires(S&& self){
 			static_cast<Ty>(std::forward_like<S>(self.val));
 		}
-	constexpr explicit(!std::convertible_to<S&&, Ty>) operator Ty(this S&& self) noexcept(noexcept(static_cast<Ty>(std::forward_like<S>(self.val)))){
+	// The explicit-specifier asks about the PAYLOAD, not about `S&&`.
+	//
+	// `convertible_to<S&&, Ty>` asks whether the wrapper converts to Ty, and
+	// answering that requires checking this very conversion operator -- clang
+	// says so: "satisfaction of constraint 'is_convertible_v<_From, _To>'
+	// depends on itself". The question it was trying to ask is whether the
+	// stored value converts implicitly, and forward_like over a declval<T&>
+	// asks exactly that with the same value category and no self-reference.
+	constexpr explicit(!std::convertible_to<decltype(std::forward_like<S>(std::declval<T&>())), Ty>) operator Ty(this S&& self) noexcept(noexcept(static_cast<Ty>(std::forward_like<S>(self.val)))){
 		return static_cast<Ty>(std::forward_like<S>(self.val));
 	}
 };
