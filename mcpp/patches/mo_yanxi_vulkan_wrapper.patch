diff --git a/mcpp.toml b/mcpp.toml
new file mode 100644
index 0000000..fae7101
--- /dev/null
+++ b/mcpp.toml
@@ -0,0 +1,33 @@
+# mcpp manifest for this library, living beside its own sources.
+# Delivered through xrgui's mcpp/patches/ until it is upstreamed; once it is,
+# nothing here has to change.
+
+[package]
+name        = "vulkan_wrapper"
+version     = "0.1.0"
+standard    = "c++23"
+description = "mo_yanxi Vulkan wrapper modules"
+license     = "BSD-2-Clause"
+
+[build]
+module_extensions = [".ixx"]
+
+sources = [
+  "src/vk_wrap/**/*.ixx",
+  "src/vk_wrap/**/*.cpp",
+]
+
+defines = ["VK_USE_64_BIT_PTR_DEFINES=1", "MO_YANXI_VULKAN_WRAPPER_ENABLE_CHECK=0"]
+
+cxxflags = ["-Wno-interference-size", "-Wno-changes-meaning"]
+
+[dependencies]
+utility = { path = "external/mo_yanxi_utility" }
+
+[dependencies.compat]
+vulkan = "1.4.357.0"
+# VMA 的实现 TU 由包提供（动态解析入口点），见 vma.ixx 里 pVulkanFunctions 的补齐
+vulkan-memory-allocator = "3.4.0"
+
+[targets.vulkan_wrapper]
+kind = "lib"
