diff --git a/src/vk_wrap/util/exception.ixx b/src/vk_wrap/util/exception.ixx
index 99ad0b5..5115ae4 100644
--- a/src/vk_wrap/util/exception.ixx
+++ b/src/vk_wrap/util/exception.ixx
@@ -6,44 +6,56 @@ export module mo_yanxi.vk.util:exception;
 
 import std;
 
+// These derive from std::runtime_error rather than std::exception.
+//
+// `std::exception(const char*)` is an MSVC extension -- the standard
+// std::exception has only a default constructor, so libstdc++/libc++ reject it.
+// std::runtime_error is the portable base that actually carries a message, and
+// its what() is `noexcept`, which also fixes the "looser exception
+// specification on overriding virtual function" error the old `const char*
+// what() const` overrides produced.
+//
+// Constructing from std::string{msg} rather than msg.data() is not incidental:
+// a string_view is not guaranteed NUL-terminated, so the old code read past the
+// end for any view that was not.
 namespace mo_yanxi::vk{
-	export struct vk_error final : std::exception{
+	export struct vk_error final : std::runtime_error{
 		[[nodiscard]] vk_error(const VkResult result, const std::string_view msg)
-			: std::exception(msg.data()), result{result}{
+			: std::runtime_error(std::string{msg}), result{result}{
 		}
 
 		VkResult result{};
 
-		[[nodiscard]] const char* what() const override{
-			return std::exception::what();
+		[[nodiscard]] const char* what() const noexcept override{
+			return std::runtime_error::what();
 		}
 	};
 
-	export struct unqualified_error final : std::exception{
-		[[nodiscard]] unqualified_error() : std::exception("Env/Device Disabled"){
+	export struct unqualified_error final : std::runtime_error{
+		[[nodiscard]] unqualified_error() : std::runtime_error("Env/Device Disabled"){
 
 		}
 
 		[[nodiscard]] unqualified_error(const std::string_view msg)
-			: std::exception(msg.data()){
+			: std::runtime_error(std::string{msg}){
 		}
 
-		[[nodiscard]] const char* what() const override{
-			return std::exception::what();
+		[[nodiscard]] const char* what() const noexcept override{
+			return std::runtime_error::what();
 		}
 	};
 
-	struct ambiguous_error final : std::exception{
-		[[nodiscard]] ambiguous_error() : std::exception("Ambiguous Setting"){
+	struct ambiguous_error final : std::runtime_error{
+		[[nodiscard]] ambiguous_error() : std::runtime_error("Ambiguous Setting"){
 
 		}
 
 		[[nodiscard]] ambiguous_error(const std::string_view msg)
-			: std::exception(msg.data()){
+			: std::runtime_error(std::string{msg}){
 		}
 
-		[[nodiscard]] const char* what() const override{
-			return std::exception::what();
+		[[nodiscard]] const char* what() const noexcept override{
+			return std::runtime_error::what();
 		}
 	};
 }
