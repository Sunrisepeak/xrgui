diff --git a/src/vk_wrap/util/vma.ixx b/src/vk_wrap/util/vma.ixx
index 9f3ebf7..6553c5f 100644
--- a/src/vk_wrap/util/vma.ixx
+++ b/src/vk_wrap/util/vma.ixx
@@ -196,6 +196,21 @@ public:
 	[[nodiscard]] allocator() = default;
 
 	[[nodiscard]] explicit(false) allocator(const VmaAllocatorCreateInfo& info){
+		// compat.vulkan-memory-allocator builds VMA with VMA_DYNAMIC_VULKAN_FUNCTIONS,
+		// so the package links against the Vulkan headers alone rather than dragging a
+		// loader into everything that allocates memory. The cost is that VMA no longer
+		// resolves entry points by name: it wants these two and fetches the rest itself.
+		// We do link the loader, so the real symbols are here to hand.
+		if(info.pVulkanFunctions == nullptr){
+			static constexpr VmaVulkanFunctions bootstrap{
+				.vkGetInstanceProcAddr = &::vkGetInstanceProcAddr,
+				.vkGetDeviceProcAddr   = &::vkGetDeviceProcAddr,
+			};
+			VmaAllocatorCreateInfo patched = info;
+			patched.pVulkanFunctions = &bootstrap;
+			vmaCreateAllocator(&patched, &handle);
+			return;
+		}
 		vmaCreateAllocator(&info, &handle);
 	}
 
