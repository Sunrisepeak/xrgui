 #ifdef MO_YANXI_ALLOCATOR_2D_USE_STD_MODULE
+// Guarded so a module interface that #includes this header AFTER its module
+// declaration can do the import itself: an import introduced by a #include in
+// the module purview is ill-formed ("post-module-declaration imports must not
+// be from header inclusion"). Define MO_YANXI_ALLOCATOR_2D_EXTERNAL_IMPORTS
+// and issue `import std;` before the include.
+#ifndef MO_YANXI_ALLOCATOR_2D_EXTERNAL_IMPORTS
 import std;
+#endif
 #else
 #include <utility>
 #include <version>
@@ -60,7 +67,9 @@ import std;
 
 
 #ifdef MO_YANXI_ALLOCATOR_2D_HAS_MATH_VECTOR2
