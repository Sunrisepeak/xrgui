+# mcpp manifest for this library, living beside its own sources.
+# Delivered through xrgui's mcpp/patches/ until it is upstreamed; once it is,
+# nothing here has to change.
+
+[package]
+name        = "react_flow"
+version     = "0.1.0"
+standard    = "c++23"
+description = "mo_yanxi reactive data-flow graph modules"
+license     = "BSD-2-Clause"
+
+[build]
+module_extensions = [".ixx"]
+
+# 对齐 xmake 侧 target("mo_yanxi.react_flow")：只收 src/**.ixx
+# （test/ examples/ benchmark/ 的 .cpp 不属于库）
+sources = ["src/**/*.ixx"]
+
+cxxflags = ["-Wno-interference-size", "-Wno-changes-meaning"]
+
+[dependencies]
+utility = { path = "../mo_yanxi_vulkan_wrapper/external/mo_yanxi_utility" }
+
+[targets.react_flow]
+kind = "lib"
