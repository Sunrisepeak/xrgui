// Build-time asset codegen — the mcpp counterpart of xmake.lua's
// `media.svg_to_bin` rule plus its `before_build` hook.
//
// Two outputs, both under MCPP_OUT_DIR/.assets/includes:
//
//   <rel>.svg.h          one bin2c byte list per normalized SVG, meant to be
//                        #include'd INSIDE a `char[] = { … }` initializer
//   assets_summary.h     the aggregate gui.assets.cpp includes, declaring one
//                        `constexpr inline char[]` per SVG, namespaced by the
//                        SVG's directory
//
// bin2c is a dozen lines here rather than an external tool, which is simpler
// than xmake's `utils.binary.bin2c` dependency and removes one more reason to
// need a host toolchain just to build.
//
// Before any of that, this also runs the two upstream asset generators that
// xmake exposes as `xmake xrgui.gen_icon` / `xmake xrgui.gen_slang`:
//
//   properties/assets_raw/svg_normalize.py   icons -> normalized SVGs
//   properties/build_util/slang_builder.py   .slang -> .spv
//
// so that `mcpp build` is self-contained and a local checkout gets the same
// assets CI does. Both are SKIPPED, with a message, when their tools are not
// installed -- python for the first, python and slangc for the second. That is
// deliberate: the tree must still build without them, which is what the empty
// summary below is for.
//
// The bin2c tree is written to the OUTPUT directory, never into properties/.
// The two generators above are the exception and write where upstream puts
// them (properties/assets_raw/gen, properties/assets/shader/spv), because those
// are runtime assets the application loads by path, not build inputs.
//
// Note the summary is emitted even when there are no SVGs at all. That is the
// normal state of a fresh checkout: properties/assets_raw/gen/ is produced by
// `xmake xrgui.gen_icon` and is not committed. gui.assets.cpp only needs the
// header to EXIST; an empty one compiles, which is what lets the tree build
// without Python/Node/slangc. See .agents/docs/2026-08-12-mcpp-windows.md.
import mcpp;
import std;

namespace {

// Is `tool` callable? Runs `tool --version` with output discarded. Cheap enough
// to do twice, and far more reliable than guessing at install locations.
bool have_tool(std::string_view tool) {
#ifdef _WIN32
    const auto probe = std::format("{} --version >NUL 2>&1", tool);
#else
    const auto probe = std::format("{} --version >/dev/null 2>&1", tool);
#endif
    return std::system(probe.c_str()) == 0;
}

// Runs a generator and reports failure loudly: a shader that silently failed to
// compile turns into a missing file at runtime, which is much harder to trace.
// Reports failure but does not stop the build. Two reasons: these generators
// are optional by design (the tree has to build without python/node/slangc),
// and their exit status is not trustworthy anyway -- svg_normalize.py returns 0
// even when the npx child crashes. CI asserts on the OUTPUTS instead, which is
// the only signal that actually means anything here.
void run_generator(std::string_view what, const std::string& cmd) {
    std::println("build.mcpp: {} ...", what);
    if (const int rc = std::system(cmd.c_str()); rc != 0) {
        std::println("build.mcpp: WARNING: {} exited {}\n  {}", what, rc, cmd);
    }
}

std::string sanitize(std::string_view s) {
    std::string out;
    out.reserve(s.size());
    for (const char c : s) {
        out.push_back((c == '.' || c == '-') ? '_' : c);
    }
    return out;
}

// Directory path -> C++ namespace name: `icons/ui` becomes `icons::ui`,
// matching xmake.lua's `dir:gsub("[\\/]", "::"):gsub("[%.%-]", "_")`.
std::string namespace_of(const std::filesystem::path& rel_dir) {
    std::string out;
    for (const auto& part : rel_dir) {
        if (!out.empty()) out += "::";
        out += sanitize(part.string());
    }
    return out;
}

// Write `<file>` as a comma-separated byte list. The result is #include'd
// inside a braced initializer, so it must NOT carry braces of its own.
bool write_bin2c(const std::filesystem::path& src, const std::filesystem::path& dst) {
    std::ifstream in(src, std::ios::binary);
    if (!in) return false;

    std::filesystem::create_directories(dst.parent_path());
    std::ofstream out(dst, std::ios::trunc);
    if (!out) return false;

    char byte{};
    for (std::size_t n = 0; in.get(byte); ++n) {
        if (n != 0) out << ',';
        if (n % 16 == 0) out << '\n';
        out << static_cast<int>(static_cast<unsigned char>(byte));
    }
    out << '\n';
    return true;
}

// Only rewrite when the content actually differs: the summary is an input to
// every TU that includes it, so touching it on every build would defeat
// incremental compilation.
void write_if_changed(const std::filesystem::path& path, std::string_view content) {
    if (std::ifstream in{path}; in) {
        const std::string existing{std::istreambuf_iterator<char>{in},
                                   std::istreambuf_iterator<char>{}};
        if (existing == content) return;
    }
    std::filesystem::create_directories(path.parent_path());
    std::ofstream{path, std::ios::trunc} << content;
}

} // namespace

int main() {
    const std::filesystem::path root = mcpp::manifest_dir();
    const std::filesystem::path src_base = root / "properties/assets_raw/gen";
    const std::filesystem::path out_dir =
        std::filesystem::path{mcpp::out_dir()} / ".assets/includes";

    std::filesystem::create_directories(out_dir);

    // ---- upstream asset generators (xmake's xrgui.gen_icon / gen_slang) ----
    const bool have_python = have_tool("python");

    const auto icons_in = root / "properties/assets_raw/icons";
    if (have_python && std::filesystem::is_directory(icons_in)) {
        const auto script = root / "properties/assets_raw/svg_normalize.py";
        if (std::filesystem::exists(script)) {
            const auto cmd = std::format(
                "python \"{}\" -i \"{}\" -o \"{}\"",
                script.string(), icons_in.string(),
                (root / "properties/assets_raw/gen/icons").string());
            run_generator("normalizing icons", cmd);
        }
    } else if (!have_python) {
        std::println("build.mcpp: python not found, skipping icon normalization");
    }

    const auto shader_cfg = root / "properties/assets_raw/shader/config.toml";
    if (have_python && have_tool("slangc") && std::filesystem::exists(shader_cfg)) {
        const auto script = root / "properties/build_util/slang_builder.py";
        if (std::filesystem::exists(script)) {
            const auto cmd = std::format(
                "python \"{}\" slangc \"{}\" \"{}\" -j 30 --oneshot",
                script.string(),
                (root / "properties/assets/shader/spv").string(),
                shader_cfg.string());
            run_generator("compiling slang shaders", cmd);
        }
    } else if (std::filesystem::exists(shader_cfg)) {
        std::println("build.mcpp: python and/or slangc not found, skipping shader compilation");
    }

    mcpp::rerun_if_changed_glob("properties/assets_raw/icons/**/*.svg");
    mcpp::rerun_if_changed_glob("properties/assets_raw/shader/**/*.slang");
    mcpp::rerun_if_changed_glob("properties/assets_raw/shader/config.toml");

    std::vector<std::filesystem::path> svgs;
    if (std::filesystem::is_directory(src_base)) {
        for (const auto& e : std::filesystem::recursive_directory_iterator{src_base}) {
            if (e.is_regular_file() && e.path().extension() == ".svg") {
                svgs.push_back(e.path());
            }
        }
    }
    // Directory iteration order is unspecified; the summary must be stable or
    // its content hash flaps and every consumer rebuilds.
    std::ranges::sort(svgs);

    std::string summary = "#pragma once\n";

    for (const auto& svg : svgs) {
        const auto rel = std::filesystem::relative(svg, src_base);
        const auto header_rel = std::filesystem::path{rel.string() + ".h"};
        const auto header_abs = out_dir / header_rel;

        std::error_code ec;
        const auto src_time = std::filesystem::last_write_time(svg, ec);
        const auto dst_time = std::filesystem::last_write_time(header_abs, ec);
        if (ec || !std::filesystem::exists(header_abs) || dst_time < src_time) {
            if (!write_bin2c(svg, header_abs)) {
                std::println("build.mcpp: cannot convert {}", svg.string());
                return 1;
            }
        }

        // Always spelled with '/' -- this string lands in a #include.
        std::string inc = header_rel.generic_string();
        const std::string ns = namespace_of(rel.parent_path());
        const std::string var = sanitize(rel.filename().string());

        if (!ns.empty()) summary += std::format("namespace {} {{\n", ns);
        summary += std::format(
            "#if __has_include(\"{0}\")\n"
            "constexpr inline char {1}[] = {{\n"
            "#include \"{0}\"\n"
            "}};\n"
            "#else\n"
            "constexpr inline char {1}[] = {{}};\n"
            "#endif\n",
            inc, var);
        if (!ns.empty()) summary += std::format("}} // namespace {}\n", ns);
    }

    write_if_changed(out_dir / "assets_summary.h", summary);

    // ---- runtime data next to the executable (xmake's after_build) ----
    //
    // xmake copies properties/assets and properties/vk_layer_settings.txt into
    // the target dir so the built image can find its data. build.mcpp cannot do
    // that itself: it runs during prepare, and the binary directory is not in
    // the environment contract -- ${mcpp.bin_dir} exists only as an action
    // interpolation. So it is declared as an action instead.
    //
    // `artifact` is the role whose outputs are new files rather than compile or
    // link inputs, which is what these are. Note it does NOT by itself order
    // the edge after the link: that only happens when the action's own inputs
    // are link outputs. These inputs are source files, so ninja may run the
    // copy whenever it likes -- which is fine, because runtime data does not
    // depend on the binaries. Naming a link output to force the ordering would
    // mean naming one specific target, and which targets exist depends on the
    // active features.
    //
    // One action, not two: a single copy command takes both sources, and every
    // output still has to be named because mcpp fixes the file set during
    // prepare. That is workable because the set is small and the generated
    // shaders above are already on disk by this point.
    const auto assets_src  = root / "properties/assets";
    const auto vk_settings = root / "properties/vk_layer_settings.txt";

    std::vector<std::filesystem::path> asset_files;
    if (std::filesystem::is_directory(assets_src)) {
        for (const auto& e : std::filesystem::recursive_directory_iterator{assets_src}) {
            if (e.is_regular_file()) asset_files.push_back(e.path());
        }
        std::ranges::sort(asset_files);
    }
    const bool have_vk = std::filesystem::exists(vk_settings);

    if (!asset_files.empty() || have_vk) {
        mcpp::action a;
        a.id   = "stage-runtime-data";
        a.role = "artifact";

        // argv, not a shell string. cp takes several sources and one
        // destination; Copy-Item is the Windows equivalent that handles a
        // directory and a plain file in the same call, which `copy` and
        // `xcopy` cannot.
        if (mcpp::target_os() == std::string_view{"windows"}) {
            std::string paths;
            if (!asset_files.empty()) paths += std::format("'{}'", assets_src.string());
            if (have_vk) {
                if (!paths.empty()) paths += ",";
                paths += std::format("'{}'", vk_settings.string());
            }
            a.arg("powershell").arg("-NoProfile").arg("-Command")
             .arg(std::format("Copy-Item -Force -Recurse -Path {} -Destination '${{mcpp.bin_dir}}'", paths).c_str());
        } else {
            a.arg("cp").arg("-r");
            if (!asset_files.empty()) a.arg(assets_src.string().c_str());
            if (have_vk) a.arg(vk_settings.string().c_str());
            a.arg("${mcpp.bin_dir}/");
        }

        for (const auto& f : asset_files) {
            a.input(f.string().c_str());
            const auto rel = std::filesystem::relative(f, assets_src).generic_string();
            a.output(std::format("${{mcpp.bin_dir}}/assets/{}", rel).c_str());
        }
        if (have_vk) {
            a.input(vk_settings.string().c_str())
             .output("${mcpp.bin_dir}/vk_layer_settings.txt");
        }
        a.submit();
        std::println("build.mcpp: staging {} runtime file(s) beside the binaries",
                     asset_files.size() + (have_vk ? 1u : 0u));
    }

    // ---- Windows link libraries -------------------------------------------
    //
    // Said here rather than as [target.windows.build] ldflags, because ldflags
    // reach the linker verbatim. A GNU spelling therefore arrives at MSVC's
    // link.exe unchanged, and link.exe does not reject it -- it says
    //
    //     LNK4044: unrecognized option '/luser32'; ignored
    //
    // and carries on, so the first sign of trouble is 235 unresolved externals
    // at the very end of the build. link_lib and link_search go through the
    // toolchain dialect instead: `user32` becomes user32.lib for MSVC and
    // -luser32 for GNU, a search dir becomes /LIBPATH:<dir> or -L<dir>.
    //
    // The first group is this project's own, transcribed from xmake.lua's
    // add_syslinks. The rest is not ours: compat.glfw, compat.mimalloc and
    // compat.vulkan each declare their Windows links as GNU ldflags, which the
    // MSVC linker drops for the same reason. Naming them again here is
    // duplication of package metadata and should be deleted once those packages
    // express it in a form both linkers can consume.
    if (mcpp::target_os() == std::string_view{"windows"}) {
        for (const char* lib : {
                 "advapi32", "imm32", "ole32", "shell32", "user32",  // xmake.lua
                 "gdi32",                                            // compat.glfw
                 "psapi", "bcrypt",                                  // compat.mimalloc
             }) {
            mcpp::link_lib(lib);
        }

        // compat.vulkan carries an import library -- symbol stubs only, since
        // vulkan-1.dll ships with the GPU driver -- under <pkg>/lib.
        if (const char* dir = mcpp::dep_dir("compat.vulkan"); dir && *dir) {
            mcpp::link_search((std::filesystem::path{dir} / "lib").string().c_str());
            mcpp::link_lib("vulkan-1");
        } else {
            std::println("build.mcpp: WARNING: compat.vulkan install dir is unknown, "
                         "so vulkan-1 will not be linked");
        }
    }

    // Private to this package -- consumers of xrgui have no business seeing
    // the generated tree.
    mcpp::include_dir(out_dir.string().c_str());

    // The SET of files matters, not just their contents: adding an icon has to
    // regenerate the summary, and a plain rerun-if-changed on a directory
    // would not catch it.
    mcpp::rerun_if_changed_glob("properties/assets_raw/gen/**/*.svg");

    std::println("build.mcpp: {} svg asset(s) -> {}", svgs.size(), out_dir.string());
    return 0;
}
